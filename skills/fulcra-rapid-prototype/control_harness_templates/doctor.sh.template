#!/usr/bin/env bash
# Confirm this control harness is in a runnable state before trusting it
# with real milestone work -- run after bootstrap.sh, and again after
# resuming on a fresh machine, per RUNBOOK.md.
#
# Exits non-zero and prints every real problem found (not just the
# first one) so a single run tells you everything that needs fixing.
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROBLEMS=0

check() {
  local description="$1"
  shift
  if "$@" >/dev/null 2>&1; then
    echo "  OK   $description"
  else
    echo "  FAIL $description"
    PROBLEMS=$((PROBLEMS + 1))
  fi
}

echo "--- Required files present ---"
for f in spec.md decisions.md dashboard-decision.md HARNESS_GOVERNANCE.md RUNBOOK.md README.md \
         coordinator/milestones.md coordinator/policy.md \
         coordinator/unattended-recovery.md coordinator/scheduled-operation.md coordinator/bootstrap.py \
         coordinator/run_milestone.py schemas/verdict.md \
         schemas/decision-request.md schemas/message.md \
         roles/manifest.md roles/generator.md roles/evaluator.md; do
  check "$f exists" test -f "$SCRIPT_DIR/$f"
done
check "knowledge/ directory exists" test -d "$SCRIPT_DIR/knowledge"

echo "--- Tooling ---"
# Delegate to the same resolver bootstrap.py uses (fulcra / fulcra-api /
# uvx fulcra-api) rather than a third, separate duplicate of this check --
# a prior version of doctor.sh had its own two-way check here that never
# learned about uvx when bootstrap.py's resolver did, so a fresh
# bootstrap -> doctor sequence could pass bootstrap and then fail doctor
# in a uvx-only environment despite everything actually working.
FULCRA_CLI_CHECK=$(python3 -c "
import sys
sys.path.insert(0, '$SCRIPT_DIR/coordinator')
try:
    import bootstrap
    print(' '.join(bootstrap.FULCRA_CLI))
except SystemExit:
    print('')
" 2>/dev/null)
if [ -n "$FULCRA_CLI_CHECK" ]; then
  echo "  OK   fulcra CLI resolved: $FULCRA_CLI_CHECK"
else
  echo "  FAIL no usable fulcra CLI found (tried fulcra, fulcra-api, uvx fulcra-api)"
  PROBLEMS=$((PROBLEMS + 1))
fi
check "python3 available" command -v python3

echo "--- Provider adapters ---"
if [ -n "${HARNESS_GENERATOR_CMD:-}" ]; then
  echo "  OK   HARNESS_GENERATOR_CMD is set"
else
  echo "  FAIL HARNESS_GENERATOR_CMD is not set (see README.md)"
  PROBLEMS=$((PROBLEMS + 1))
fi
if [ -n "${HARNESS_EVALUATOR_CMD:-}" ]; then
  echo "  OK   HARNESS_EVALUATOR_CMD is set"
else
  echo "  FAIL HARNESS_EVALUATOR_CMD is not set (see README.md)"
  PROBLEMS=$((PROBLEMS + 1))
fi

echo "--- spec.md not left as an unfilled template ---"
if grep -q "<!-- Fill after fulcra-prototype-grill-me" "$SCRIPT_DIR/spec.md" 2>/dev/null; then
  echo "  FAIL spec.md still contains template placeholder comments -- fill it from approved Grill-Me artifacts"
  PROBLEMS=$((PROBLEMS + 1))
else
  echo "  OK   spec.md appears to have been filled in"
fi

echo "--- Required dashboard decision ---"
DASHBOARD_STATUS=$(grep -E '^status:[[:space:]]*' "$SCRIPT_DIR/dashboard-decision.md" 2>/dev/null | head -1 | cut -d: -f2- | xargs)
DASHBOARD_CHOICE=$(grep -E '^choice:[[:space:]]*' "$SCRIPT_DIR/dashboard-decision.md" 2>/dev/null | head -1 | cut -d: -f2- | xargs)
DASHBOARD_PUBLICATION=$(grep -E '^publication:[[:space:]]*' "$SCRIPT_DIR/dashboard-decision.md" 2>/dev/null | head -1 | cut -d: -f2- | xargs)
if [ "$DASHBOARD_STATUS" != "resolved" ]; then
  echo "  FAIL dashboard decision is pending or invalid -- ask the user to confirm the recommended create-and-publish path, defer it, or decline it before runtime work"
  PROBLEMS=$((PROBLEMS + 1))
else
case "$DASHBOARD_CHOICE" in
  create_and_publish)
    if [ "$DASHBOARD_PUBLICATION" = "confirmed" ]; then
      if [ -n "${HARNESS_DASHBOARD_REFRESH_CMD:-}" ]; then
        echo "  OK   dashboard created/published with confirmed manifest"
      else
        echo "  FAIL HARNESS_DASHBOARD_REFRESH_CMD is required to refresh the active dashboard after terminal outcomes"
        PROBLEMS=$((PROBLEMS + 1))
      fi
    else
      echo "  FAIL dashboard create-and-publish path lacks confirmed public manifest -- obtain explicit deployment confirmation or explicitly defer/decline"
      PROBLEMS=$((PROBLEMS + 1))
    fi
    ;;
  defer|decline)
    echo "  OK   dashboard decision recorded: $DASHBOARD_CHOICE"
    ;;
  *)
    echo "  FAIL dashboard decision is pending or invalid -- ask the user to confirm the recommended create-and-publish path, defer it, or decline it before runtime work"
    PROBLEMS=$((PROBLEMS + 1))
    ;;
esac
fi

echo
if [ "$PROBLEMS" -eq 0 ]; then
  echo "All checks passed. Harness is ready for coordinator/run_milestone.py."
  exit 0
else
  echo "$PROBLEMS problem(s) found. Fix before running a real milestone."
  exit 1
fi
