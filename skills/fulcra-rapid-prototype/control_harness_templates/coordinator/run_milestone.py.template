#!/usr/bin/env python3
"""Run one milestone with durable Workspace state and optional Git-host adapters.

Provider commands remain external/trusted configuration:
  HARNESS_GENERATOR_CMD, HARNESS_EVALUATOR_CMD
Optional adapters:
  HARNESS_PR_CREATE_CMD, HARNESS_PR_MERGE_CMD, HARNESS_DASHBOARD_REFRESH_CMD

GitHub is not required. HARNESS_GIT_MODE=local uses only local branches;
HARNESS_GIT_MODE=remote adds origin push and optional host PR adapters.
"""
from __future__ import annotations

import argparse
import hashlib
import os
import re
import shutil
import signal
import subprocess
import sys
import tempfile
import time
from datetime import datetime, timezone
from pathlib import Path

CONTROL_HARNESS_ROOT = Path(__file__).resolve().parent.parent
ROOT = CONTROL_HARNESS_ROOT
BUNDLE_RETENTION = 3


class MilestoneError(RuntimeError):
    pass


def _resolve_fulcra_cli() -> list[str]:
    return resolve_fulcra()


def resolve_fulcra() -> list[str]:
    for name in ("fulcra", "fulcra-api"):
        if shutil.which(name):
            return [name]
    if shutil.which("uvx"):
        return ["uvx", "fulcra-api"]
    raise MilestoneError("No Fulcra CLI found (tried fulcra, fulcra-api, uvx fulcra-api).")


def run(cmd: list[str], cwd: Path | None = None, check: bool = True, **kwargs) -> subprocess.CompletedProcess[str]:
    result = subprocess.run(cmd, cwd=cwd, capture_output=True, text=True, **kwargs)
    if check and result.returncode:
        raise MilestoneError(f"Command failed: {' '.join(cmd)}\n{result.stderr.strip()}")
    return result


def context_for(milestone: str) -> str:
    path = ROOT / "coordinator" / "milestones.md"
    text = path.read_text()
    match = re.search(rf"^##\s+{re.escape(milestone)}:.*?(?=^##\s+|\Z)", text, re.M | re.S)
    if not match:
        raise MilestoneError(f"Milestone {milestone} not found in {path}")
    return match.group(0).strip()


def extract_milestone_context(milestone_id: str) -> str:
    return context_for(milestone_id)


def branch_for(milestone: str, context: str) -> str:
    title = context.splitlines()[0].split(":", 1)[-1].lower()
    slug = re.sub(r"[^a-z0-9]+", "-", title).strip("-")[:50]
    return f"milestone/{milestone.lower()}-{slug}" if slug else f"milestone/{milestone.lower()}"


def write_workspace(cli: list[str], team: str, remote: str, content: str) -> None:
    with tempfile.NamedTemporaryFile(mode="w", suffix=".md", delete=False) as f:
        f.write(content)
        local = Path(f.name)
    try:
        upload_workspace_file(cli, team, local, remote)
    finally:
        local.unlink(missing_ok=True)


def upload_workspace_file(cli: list[str], team: str, local: Path, remote: str) -> None:
    for attempt in range(1, 4):
        result = run([*cli, "file", "upload", str(local), f"team/{team}/{remote}"], check=False)
        if result.returncode == 0:
            return
        if attempt < 3:
            time.sleep(attempt)
    raise MilestoneError(f"Could not persist Workspace record team/{team}/{remote}")


def persist_status(cli: list[str] | None, team: str | None, outcome: str, milestone: str, where: str, going: str, next_bearing: str) -> bool:
    if not cli or not team:
        return False
    now = datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")
    content = f"---\ntype: Harness Status Summary\n---\n\n# Harness checkpoint\n- **Outcome:** {outcome}\n- **Milestone:** {milestone}\n- **Updated:** {now}\n\n## Where we are\n{where}\n\n## Where we're going\n{going}\n\n## Next bearing\n{next_bearing}\n"
    write_workspace(cli, team, "status-summary.md", content)
    return True


def dashboard_choice() -> str:
    text = (ROOT / "dashboard-decision.md").read_text()
    if not re.search(r"^status:\s*resolved\s*$", text, re.M):
        return ""
    match = re.search(r"^choice:\s*(\S+)", text, re.M)
    return match.group(1) if match else ""


def refresh_dashboard_if_active(team: str | None, milestone: str, outcome: str) -> None:
    if dashboard_choice() != "create_and_publish":
        return
    command = os.getenv("HARNESS_DASHBOARD_REFRESH_CMD")
    if not command:
        raise MilestoneError("HARNESS_DASHBOARD_REFRESH_CMD is required for an active published dashboard.")
    adapter(command, {
        "HARNESS_TEAM": team or "",
        "HARNESS_MILESTONE": milestone,
        "HARNESS_OUTCOME": outcome,
        "HARNESS_DASHBOARD_DECISION": str(ROOT / "dashboard-decision.md"),
    }, "dashboard-refresh")


def record_dashboard_refresh_failure(cli: list[str] | None, team: str | None, milestone: str, outcome: str, error: Exception) -> None:
    """Best-effort durable marker; dashboard trouble must not alter the run result."""
    if not cli or not team:
        return
    now = datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")
    content = f"# Dashboard refresh status\n\n- state: refresh_failed_or_stale\n- milestone: {milestone}\n- outcome: {outcome}\n- updated: {now}\n- error: {error}\n\nThe canonical harness outcome is in `status-summary.md`. Repair the dashboard adapter and refresh from that durable record.\n"
    try:
        write_workspace(cli, team, "dashboard/refresh-status.md", content)
    except Exception as persist_error:
        print(f"WARNING: dashboard refresh failed ({error}); could not persist dashboard staleness marker: {persist_error}", file=sys.stderr)


def record_terminal_outcome(cli: list[str] | None, team: str | None, outcome: str, milestone: str, where: str, going: str, next_bearing: str) -> bool:
    """Persist the canonical outcome before a best-effort dashboard refresh.

    A broken optional dashboard must be visible, but cannot turn a PASS into
    a failed harness run.  Likewise, never invoke its hook when the canonical
    Workspace write failed or was not configured.
    """
    try:
        persisted = persist_status(cli, team, outcome, milestone, where, going, next_bearing)
    except Exception as error:
        print(f"WARNING: terminal outcome was not persisted; dashboard refresh skipped: {error}", file=sys.stderr)
        return False
    if not persisted:
        print("WARNING: terminal outcome was not persisted; dashboard refresh skipped (no Workspace team configured).", file=sys.stderr)
        return False
    try:
        refresh_dashboard_if_active(team, milestone, outcome)
    except Exception as error:
        print(f"WARNING: dashboard refresh failed after persisted {outcome} outcome: {error}", file=sys.stderr)
        record_dashboard_refresh_failure(cli, team, milestone, outcome, error)
    return True


def role_command(role: str, command: str, milestone: str, context: str, deliverable: Path, timeout: int, retries: int, candidate_id: str = "", candidate_sha: str | None = None) -> str:
    env = os.environ.copy()
    env.update({
        "HARNESS_ROLE": role,
        "HARNESS_MILESTONE": milestone,
        "HARNESS_SPEC": str(ROOT / "spec.md"),
        "HARNESS_CONTEXT": context,
        "HARNESS_DELIVERABLE": str(deliverable),
        "HARNESS_CANDIDATE_ID": candidate_id,
    })
    if candidate_sha:
        env["HARNESS_CANDIDATE_SHA"] = candidate_sha
    transient = re.compile(r"429|rate limit|usage limit|session limit", re.I)
    last = ""
    for attempt in range(1, retries + 1):
        proc = subprocess.Popen(command, shell=True, cwd=deliverable, env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, start_new_session=True)
        try:
            stdout, stderr = proc.communicate(timeout=timeout)
        except subprocess.TimeoutExpired:
            try:
                os.killpg(proc.pid, signal.SIGTERM)
            except ProcessLookupError:
                pass
            try:
                stdout, stderr = proc.communicate(timeout=10)
            except subprocess.TimeoutExpired:
                try:
                    os.killpg(proc.pid, signal.SIGKILL)
                except ProcessLookupError:
                    pass
                stdout, stderr = proc.communicate()
            last = f"{role} exceeded {timeout}s wall clock; terminated provider process group"
            retryable = True
        else:
            output = stdout + ("\n" + stderr if stderr else "")
            if proc.returncode == 0:
                return stdout
            last = f"{role} exited {proc.returncode}: {output[-2000:]}"
            retryable = bool(transient.search(output))
        if not retryable or attempt == retries:
            raise MilestoneError(last)
        time.sleep(attempt)
    raise MilestoneError(last)


def verdict_from(output: str) -> dict[str, str]:
    found: dict[str, str] = {}
    for line in output.splitlines():
        match = re.match(r"^\s*(overall|test_runner|decision_request)\s*:\s*(PASS|FAIL|true|false)\s*$", line, re.I)
        if match:
            found[match.group(1).lower()] = match.group(2).upper()
    if "overall" not in found:
        raise MilestoneError("Evaluator output missing overall: PASS|FAIL")
    return found


def is_mergeable(verdict: dict[str, str], test_runner_declared: bool) -> bool:
    return verdict.get("overall") == "PASS" and (not test_runner_declared or verdict.get("test_runner") == "PASS")


def adapter(command: str | None, env: dict[str, str], label: str) -> None:
    if not command:
        print(f"No {label} adapter configured; leaving this as a manual host action.")
        return
    result = subprocess.run(command, shell=True, env={**os.environ, **env}, capture_output=True, text=True)
    if result.returncode:
        raise MilestoneError(f"{label} adapter failed: {result.stderr.strip()}")
    print(result.stdout)


def current_branch(deliverable: Path) -> str:
    return run(["git", "-C", str(deliverable), "branch", "--show-current"]).stdout.strip()


def integration_branch_for(deliverable: Path, mode: str, configured: str | None) -> str:
    if configured:
        return configured
    if mode == "remote":
        remote_head = run(["git", "-C", str(deliverable), "symbolic-ref", "--short", "refs/remotes/origin/HEAD"], check=False).stdout.strip()
        if remote_head.startswith("origin/"):
            return remote_head.removeprefix("origin/")
    branch = current_branch(deliverable)
    if branch and not branch.startswith("milestone/"):
        return branch
    for candidate in ("main", "master"):
        if run(["git", "-C", str(deliverable), "rev-parse", "--verify", candidate], check=False).returncode == 0:
            return candidate
    raise MilestoneError("Cannot determine integration branch; pass --integration-branch or set HARNESS_INTEGRATION_BRANCH.")


def ensure_milestone_branch(deliverable: Path, branch: str, mode: str = "remote", integration_branch: str | None = None) -> str:
    """Checkout a safe milestone branch and return its starting SHA."""
    dirty = run(["git", "-C", str(deliverable), "status", "--porcelain"], check=False).stdout.strip()
    active = current_branch(deliverable)
    if dirty:
        if active == branch:
            print(f"Resuming dirty work on {branch} in place.")
            return run(["git", "-C", str(deliverable), "rev-parse", "HEAD"]).stdout.strip()
        raise MilestoneError("Deliverable is dirty on a different branch; preserve it through the recovery protocol before branch preparation.")
    local = run(["git", "-C", str(deliverable), "rev-parse", "--verify", branch], check=False).returncode == 0
    if local:
        run(["git", "-C", str(deliverable), "checkout", branch])
    elif mode == "remote":
        run(["git", "-C", str(deliverable), "fetch", "origin"], check=False)
        remote = run(["git", "-C", str(deliverable), "rev-parse", "--verify", f"origin/{branch}"], check=False).returncode == 0
        if remote:
            run(["git", "-C", str(deliverable), "checkout", "-B", branch, f"origin/{branch}"])
        else:
            base = f"origin/{integration_branch}" if integration_branch else "origin/main"
            if run(["git", "-C", str(deliverable), "rev-parse", "--verify", base], check=False).returncode != 0:
                raise MilestoneError(f"Cannot resolve remote integration branch {base}.")
            run(["git", "-C", str(deliverable), "checkout", "-B", branch, base])
    else:
        if not integration_branch or run(["git", "-C", str(deliverable), "rev-parse", "--verify", integration_branch], check=False).returncode != 0:
            raise MilestoneError("Cannot resolve local integration branch.")
        run(["git", "-C", str(deliverable), "checkout", "-B", branch, integration_branch])
    return run(["git", "-C", str(deliverable), "rev-parse", "HEAD"]).stdout.strip()


def has_new_commit(deliverable: Path, start_sha: str) -> bool:
    return run(["git", "-C", str(deliverable), "rev-parse", "HEAD"]).stdout.strip() != start_sha


def candidate_id_for(milestone: str) -> str:
    """A stable, human-searchable marker; the candidate SHA is authoritative."""
    return f"harness/{milestone.lower()}-candidate"


def validate_candidate(deliverable: Path, branch: str, start_sha: str, candidate_id: str) -> str:
    if run(["git", "-C", str(deliverable), "status", "--porcelain"], check=False).stdout.strip():
        raise MilestoneError("Generator returned with uncommitted work; final report is preserved before this gate.")
    if current_branch(deliverable) != branch:
        raise MilestoneError("Generator changed branches; refusing to evaluate an ambiguous candidate.")
    if not has_new_commit(deliverable, start_sha):
        raise MilestoneError("Generator made no new commit for this invocation; refusing no-op evaluation.")
    sha = run(["git", "-C", str(deliverable), "rev-parse", "HEAD"]).stdout.strip()
    message = run(["git", "-C", str(deliverable), "log", "-1", "--format=%B", sha]).stdout
    if f"Harness-Candidate: {candidate_id}" not in message:
        raise MilestoneError(f"Final candidate commit must include trailer: Harness-Candidate: {candidate_id}")
    return sha


def candidate_record(milestone: str, candidate_id: str, sha: str, branch: str, start_sha: str, generator_output: str) -> str:
    digest = hashlib.sha256(generator_output.encode()).hexdigest()
    return f"# Evaluation candidate\n\n- milestone: {milestone}\n- candidate_id: {candidate_id}\n- candidate_sha: {sha}\n- branch: {branch}\n- base_sha: {start_sha}\n- commit_range: {start_sha}..{sha}\n- generator_report_sha256: {digest}\n- status: ready_for_evaluation\n"


def archive_repositories(cli: list[str] | None, team: str | None, milestone: str, deliverable: Path, pruning_approved: bool) -> None:
    """Upload full-history bundles and optionally invoke a trusted version-pruner.

    Fulcra's portable CLI exposes upload/stat/restore/delete-file, but not a
    delete-one-version command. Pruning is therefore an explicit host adapter
    boundary, never an unsafe guess at File Store internals.
    """
    if not cli or not team:
        return
    for label, repo in (("control-harness", CONTROL_HARNESS_ROOT), ("deliverable", deliverable)):
        with tempfile.NamedTemporaryFile(prefix=f"{label}-", suffix=".bundle", delete=False) as f:
            bundle = Path(f.name)
        try:
            run(["git", "-C", str(repo), "bundle", "create", str(bundle), "--all"])
            upload_workspace_file(cli, team, bundle, f"artifact/git-bundles/{milestone}/{label}-latest.bundle")
        finally:
            bundle.unlink(missing_ok=True)
    pruner = os.getenv("HARNESS_BUNDLE_PRUNE_CMD")
    if not pruning_approved:
        print(f"Bundle retention is {BUNDLE_RETENTION}; no old versions deleted until the user explicitly approves pruning.")
        return
    if not pruner:
        raise MilestoneError("Bundle pruning was approved but HARNESS_BUNDLE_PRUNE_CMD is not configured for version-level deletion.")
    adapter(pruner, {
        "HARNESS_BUNDLE_TEAM": team,
        "HARNESS_BUNDLE_MILESTONE": milestone,
        "HARNESS_BUNDLE_RETENTION": str(BUNDLE_RETENTION),
        "HARNESS_BUNDLE_PATH": f"team/{team}/artifact/git-bundles/{milestone}",
    }, "bundle-prune")


def integrate_local(deliverable: Path, integration_branch: str, candidate_sha: str, milestone: str) -> str:
    """Create the mandatory non-fast-forward milestone completion merge."""
    completion_marker = f"harness/{milestone.lower()}"
    run(["git", "-C", str(deliverable), "checkout", integration_branch])
    run(["git", "-C", str(deliverable), "merge", "--no-ff", candidate_sha, "-m", f"{completion_marker}: complete milestone"])
    return run(["git", "-C", str(deliverable), "rev-parse", "HEAD"]).stdout.strip()


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--milestone", required=True)
    parser.add_argument("--deliverable", type=Path, required=True)
    parser.add_argument("--team", default=os.getenv("HARNESS_TEAM"))
    parser.add_argument("--git-mode", choices=("local", "remote"), default=os.getenv("HARNESS_GIT_MODE", "remote"))
    parser.add_argument("--integration-branch", default=os.getenv("HARNESS_INTEGRATION_BRANCH"))
    parser.add_argument("--approve-bundle-pruning", action="store_true", default=os.getenv("HARNESS_BUNDLE_PRUNING_APPROVED") == "1")
    parser.add_argument("--role-timeout", type=int, default=int(os.getenv("HARNESS_ROLE_TIMEOUT_SECONDS", "7200")))
    parser.add_argument("--max-retries", type=int, default=int(os.getenv("HARNESS_MAX_RETRIES", "3")))
    parser.add_argument("--no-test-runner", action="store_true")
    parser.add_argument("--dry-run", action="store_true")
    args = parser.parse_args()
    deliverable = args.deliverable.resolve()
    if not deliverable.is_dir():
        raise MilestoneError(f"Deliverable not found: {deliverable}")

    context = context_for(args.milestone)
    branch = branch_for(args.milestone, context)
    cli = resolve_fulcra() if args.team else None
    print(f"Milestone: {args.milestone}\nGit mode: {args.git_mode}\nBranch: {branch}")
    if args.dry_run:
        return 0
    generator, evaluator = os.getenv("HARNESS_GENERATOR_CMD"), os.getenv("HARNESS_EVALUATOR_CMD")
    if not generator or not evaluator:
        raise MilestoneError("HARNESS_GENERATOR_CMD and HARNESS_EVALUATOR_CMD are required.")
    integration_branch = integration_branch_for(deliverable, args.git_mode, args.integration_branch)
    start_sha = ensure_milestone_branch(deliverable, branch, args.git_mode, integration_branch)
    candidate_id = candidate_id_for(args.milestone)
    terminal_outcome_recorded = False
    try:
        generator_output = role_command("generator", generator, args.milestone, context, deliverable, args.role_timeout, args.max_retries, candidate_id)
        if cli and args.team:
            write_workspace(cli, args.team, f"artifact/{args.milestone}-generator.md", generator_output)
        candidate_sha = validate_candidate(deliverable, branch, start_sha, candidate_id)
        if cli and args.team:
            write_workspace(cli, args.team, f"artifact/{args.milestone}-{candidate_id.replace('/', '-')}.md", candidate_record(args.milestone, candidate_id, candidate_sha, branch, start_sha, generator_output))
        completion_marker = f"harness/{args.milestone.lower()}"
        host_env = {"HARNESS_BRANCH": branch, "HARNESS_MILESTONE": args.milestone, "HARNESS_DELIVERABLE": str(deliverable), "HARNESS_CANDIDATE_ID": candidate_id, "HARNESS_CANDIDATE_SHA": candidate_sha, "HARNESS_MERGE_MESSAGE": f"{completion_marker}: complete milestone"}
        if args.git_mode == "remote":
            run(["git", "-C", str(deliverable), "push", "-u", "origin", branch])
            adapter(os.getenv("HARNESS_PR_CREATE_CMD"), host_env, "PR-create")
        run(["git", "-C", str(deliverable), "checkout", "--detach", candidate_sha])
        evaluator_output = role_command("evaluator", evaluator, args.milestone, context, deliverable, args.role_timeout, args.max_retries, candidate_id, candidate_sha)
        verdict = verdict_from(evaluator_output)
        if cli and args.team:
            write_workspace(cli, args.team, f"artifact/{args.milestone}-verdict.md", evaluator_output)
        if verdict.get("decision_request") == "TRUE":
            if cli and args.team:
                write_workspace(cli, args.team, f"decision/{args.milestone}-decision-request.md", evaluator_output)
            record_terminal_outcome(cli, args.team, "DECISION REQUIRED", args.milestone, "Evaluator emitted a user decision request.", "The milestone is paused pending user input.", "Record user answer in decisions.md/spec before resuming.")
            terminal_outcome_recorded = True
            return 1
        if not is_mergeable(verdict, test_runner_declared=not args.no_test_runner):
            record_terminal_outcome(cli, args.team, "FAIL", args.milestone, f"Evaluator verdict: {verdict}", "Candidate commit and branch remain available for a bounded corrective iteration.", "Resume the milestone branch and create a new candidate.")
            terminal_outcome_recorded = True
            return 1
        if args.git_mode == "local":
            integration_sha = integrate_local(deliverable, integration_branch, candidate_sha, args.milestone)
        else:
            adapter(os.getenv("HARNESS_PR_MERGE_CMD"), host_env, "PR-merge")
            integration_sha = "host adapter responsible for non-fast-forward completion merge"
        if cli and args.team:
            write_workspace(cli, args.team, "milestone-progress.md", f"current: <next milestone>\ncompleted: {args.milestone}\n")
        record_terminal_outcome(cli, args.team, "PASS", args.milestone, f"Independent evaluator passed {candidate_id} ({candidate_sha}); completion {completion_marker}: {integration_sha}.", "The harness may advance to the next milestone.", "Advance to the next milestone.")
        terminal_outcome_recorded = True
        return 0
    except MilestoneError as exc:
        if not terminal_outcome_recorded:
            record_terminal_outcome(cli, args.team, "ESCALATED", args.milestone, str(exc), "Provider, candidate validation, or evaluator processing did not complete.", "Resolve the recorded blocker, then resume this branch.")
        raise
    finally:
        archive_repositories(cli, args.team, args.milestone, deliverable, args.approve_bundle_pruning)


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except MilestoneError as exc:
        print(f"ERROR: {exc}", file=sys.stderr)
        raise SystemExit(1)
